# 이 파일을 .env 로 복사해서 쓰세요. (.env는 git에 올리지 마세요)

# MySQL 접속 주소. 형식: mysql+pymysql://아이디:비밀번호@호스트:포트/DB이름?charset=utf8mb4
# docker-compose로 띄운 로컬 MySQL이면 그대로 쓰면 됩니다.
# 비밀번호에 @ : / 같은 특수문자가 있으면 URL 인코딩 필요 (예: @ → %40)
DATABASE_URL=mysql+pymysql://gachi:gachi1234@localhost:3306/gachi?charset=utf8mb4

# 프론트 주소. 쉼표로 여러 개 (배포한 프론트 주소 추가)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# true면 실행되는 SQL을 로그로 출력
SHOW_SQL=false

# Kakao Developers > 앱 > 플랫폼 키에서 확인
KAKAO_REST_API_KEY=replace_with_kakao_rest_api_key
KAKAO_CLIENT_SECRET=replace_with_kakao_client_secret

# Kakao Developers에 등록한 Redirect URI와 정확히 일치해야 합니다.
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback
FRONTEND_AUTH_SUCCESS_URL=http://localhost:3000/auth/callback

# 직접 생성한 서비스 JWT 서명 키 (예: python3 -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# HTTPS 배포 환경에서는 true로 설정합니다.
AUTH_COOKIE_SECURE=false

# Swagger 로컬 테스트용 임시 사용자 헤더. 로컬에서만 development/true로 설정하세요.
APP_ENV=production
DEV_AUTH_ENABLED=false
